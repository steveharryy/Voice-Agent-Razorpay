# ===================================================
# Razorpay Autopay Recovery Voice Agent Configuration
# ===================================================

# --- VAPI.AI TELEPHONY CONFIGURATION ---
# Optional for real phone outdialing. If left empty, the built-in Interactive
# Browser Voice AI Simulator runs out-of-the-box with zero setup!
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Your personal verified phone number for testing real phone calls (E.164 format, e.g. +919876543210)
# Remember: Use ONLY a number you control or have explicit permission to call!
TEST_PHONE_NUMBER=+919876543210

# --- RAZORPAY API KEYS (Optional for Live API links, mocked by default) ---
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key_456

# --- APPLICATION SETTINGS ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
